# انسخ هذا الملف إلى .env.local وضع قيمك الحقيقية فيه. لا ترفع .env.local إلى GitHub.

# الذكاء الاصطناعي (Groq)
GROQ_API_KEY=
# اختياري: لتغيير المزود أو النموذج (أي واجهة متوافقة مع OpenAI)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# رابط المكتب (يظهر في زر البطاقة داخل Teams)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# الطريقة الأولى: رابط Workflows لقناة Teams
TEAMS_WEBHOOK_URL=

# الطريقة الثانية: رمز الأمان (Security token) الذي يظهر مرة واحدة عند إنشاء Outgoing Webhook
TEAMS_OUTGOING_WEBHOOK_SECRET=

# اجتماعات Teams عبر Microsoft Graph
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_USER_ID=
